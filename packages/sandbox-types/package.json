{
  "name": "@academy/sandbox-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types for the OS-level sandbox. Used by apps/desktop (Electron main process) and apps/web (admin UI).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "tsc --noEmit && npx --yes tsx src/index.test.ts"
  },
  "dependencies": {
    "@academy/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.7.0"
  }
}

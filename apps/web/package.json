{
  "name": "@tether-academy/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-monaco.mjs",
    "dev": "next dev --turbopack",
    "predev:webpack": "node scripts/copy-monaco.mjs",
    "dev:webpack": "next dev",
    "dev:clean": "node scripts/copy-monaco.mjs && node ../../packages/courses/scripts/dev-clean.mjs && next dev --turbopack",
    "prebuild": "node scripts/copy-monaco.mjs && node scripts/copy-install-sh.mjs && pnpm -w run build:packages && pnpm -w run check:yaml && pnpm -w run verify:tests:check && pnpm lint && pnpm check",
    "build": "next build",
    "build:dev": "next build",
    "start": "BASE_PATH=/tether-academy node serve.mjs",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@academy/config": "workspace:*",
    "@academy/core": "workspace:*",
    "@academy/courses": "workspace:*",
    "@academy/ui": "workspace:*",
    "@academy/validation": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "fumadocs-core": "^15.0.0",
    "fumadocs-mdx": "13.0.0",
    "fumadocs-ui": "^15.0.0",
    "geist": "^1.7.2",
    "lucide-react": "^0.469.0",
    "monaco-editor": "^0.56.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^3.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
